    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Run a simulation, run a learning comparison, or open a saved run. Fixed white labels stay readable in both appearances.",
      "html": "<button class=\"ds-button-primary\">Run experiment</button>",
      "css": ".ds-button-primary{font-family:\"IBM Plex Sans\",sans-serif;font-variant-numeric:tabular-nums;background:var(--brand-bright);color:#fff;border:1px solid var(--accent);border-radius:8px;min-height:42px;}.ds-button-primary:hover{background:#5823bd;border-color:#fff;}.ds-button-primary:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A lower-priority working action with a visible control outline.",
      "html": "<button class=\"ds-button-secondary\">Go to Experiment</button>",
      "css": ".ds-button-secondary{font-family:\"IBM Plex Sans\",sans-serif;font-variant-numeric:tabular-nums;background:var(--surface-raised);color:var(--text);border:1px solid var(--control-border);border-radius:8px;}.ds-button-secondary:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}"
    },
    {
      "name": "Number field",
      "kind": "input",
      "refersTo": "input-number",
      "description": "A quantity label, units, raised surface, and visible outline; retain native number-input keyboard behavior.",
      "html": "<label class=\"ds-field\">Dephasing rate \u03b3 (1/time)<input class=\"ds-number\" type=\"number\" min=\"0\" max=\"2\" step=\"0.1\" value=\"1.00\"></label>",
      "css": ".ds-field{font-family:\"IBM Plex Sans\",sans-serif;font-variant-numeric:tabular-nums;display:grid;gap:.5rem;color:var(--text);font-size:14px;}.ds-number{font-family:\"IBM Plex Sans\",sans-serif;font-variant-numeric:tabular-nums;background:var(--surface-raised);color:var(--text);border:1px solid var(--control-border);border-radius:8px;caret-color:var(--accent);}.ds-number:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}"
    },
    {
      "name": "Dashboard navigation",
      "kind": "nav",
      "description": "Three native horizontal radio choices with visible selected marks and keyboard support.",
      "html": "<nav aria-label=\"Dashboard view\" class=\"ds-nav\"><label><input class=\"ds-nav-radio\" type=\"radio\" name=\"ds-view\" checked> Experiment</label><label><input class=\"ds-nav-radio\" type=\"radio\" name=\"ds-view\"> Saved runs</label><label><input class=\"ds-nav-radio\" type=\"radio\" name=\"ds-view\"> Benchmark</label></nav>",
      "css": ".ds-nav{font-family:\"IBM Plex Sans\",sans-serif;font-variant-numeric:tabular-nums;display:flex;flex-wrap:wrap;gap:1rem;color:var(--text);}.ds-nav-radio{accent-color:var(--accent);}.ds-nav-radio:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}"
    },
    {
      "name": "Simulation scope chip",
      "kind": "chip",
      "refersTo": "scope-chip",
      "description": "A static simulation-only scope label. It is not a button or a color-only status.",
      "html": "<span class=\"ds-scope\">Simulation only</span>",
      "css": ".ds-scope{font-family:\"IBM Plex Sans\",sans-serif;font-variant-numeric:tabular-nums;display:inline-block;color:var(--accent);background:var(--background);border:1px solid var(--border);border-radius:999px;padding:.35rem .8rem;font-size:14px;white-space:nowrap;}"
    },
    {
      "name": "Validation expander",
      "kind": "card",
      "refersTo": "expander",
      "description": "Quiet bordered disclosure for saved provenance and numerical validation. The original application uses Streamlit disclosures.",
      "html": "<details class=\"ds-expander\"><summary class=\"ds-expander-summary\">Saved record and numerical validation</summary><p class=\"ds-expander-copy\">Saved on this laptop. The configuration is immutable; changing settings creates a new run.</p></details>",
      "css": ".ds-expander{font-family:\"IBM Plex Sans\",sans-serif;font-variant-numeric:tabular-nums;color:var(--text);background:var(--background);border:1px solid var(--border);border-radius:8px;}.ds-expander-summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}.ds-expander-copy{color:var(--muted);font-size:14px;line-height:1.55;}"
